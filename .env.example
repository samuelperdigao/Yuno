# Ambiente
APP_ENV=production
YUNO_DOMAIN=yuno.example.com
PUBLIC_BASE_URL=https://yuno.example.com
API_BASE_URL=http://api:8000
VITE_API_BASE_URL=https://yuno.example.com/api

# Banco/cache
POSTGRES_PASSWORD=change-me-postgres
DATABASE_URL=postgresql+asyncpg://yuno:change-me-postgres@postgres:5432/yuno
REDIS_URL=redis://redis:6379/0

# Object Storage privado (MinIO/S3)
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=yuno-farm-proofs
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_PATH_STYLE=true
# AES256 ou aws:kms; deixe vazio se o provider aplicar criptografia no bucket.
OBJECT_STORAGE_SSE=
OBJECT_STORAGE_PRESIGN_SECONDS=300

# Segredos internos
SECRET_KEY=change-me
ADMIN_TOKEN=change-me-admin
BOT_INTERNAL_TOKEN=change-me-bot

# Discord
DISCORD_BOT_TOKEN=
DISCORD_TEST_GUILD_ID=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://yuno.example.com/auth/discord/callback
DISCORD_INVITE_URL=
CONTROL_PLANE_ENABLED=false

# Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# Caddy/SSL
ADMIN_EMAIL=admin@example.com
